<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 y posteriores: nada de la app va a la copia en la nube ni
     se pasa a un teléfono nuevo. La sesión está cifrada con una clave del
     Keystore de ESTE teléfono; copiada a otro, no se podría leer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
    </device-transfer>
</data-extraction-rules>
